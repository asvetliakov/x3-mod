+/* See GST_FFMPEGAUDDEC_FLOAT_LIMIT: limit a decoded float buffer in place.
+ * One pass over the samples of the frame just copied (44100 floats/s on this
+ * path); integer formats and the non-mappable case return immediately. */
+static void
+gst_ffmpegauddec_limit_float (GstFFMpegAudDec * ffmpegdec, GstBuffer * outbuf)
+{
+  GstAudioFormat format = GST_AUDIO_INFO_FORMAT (&ffmpegdec->info);
+  GstMapInfo map;
+  gsize i, n;
+
+  if (format != GST_AUDIO_FORMAT_F32 && format != GST_AUDIO_FORMAT_F64)
+    return;
+
+  if (G_UNLIKELY (!gst_buffer_map (outbuf, &map, GST_MAP_READWRITE))) {
+    GST_WARNING_OBJECT (ffmpegdec, "could not map the output buffer writable");
+    return;
+  }
+
+  if (format == GST_AUDIO_FORMAT_F32) {
+    const gfloat limit = (gfloat) GST_FFMPEGAUDDEC_FLOAT_LIMIT;
+    gfloat *s = (gfloat *) map.data;
+
+    n = map.size / sizeof (gfloat);
+    for (i = 0; i < n; i++) {
+      gfloat v = s[i];
+
+      if (v > limit)
+        s[i] = limit;
+      else if (v < -limit)
+        s[i] = -limit;
+      else if (G_UNLIKELY (v != v))
+        s[i] = 0.0f;
+    }
+  } else {
+    const gdouble limit = GST_FFMPEGAUDDEC_FLOAT_LIMIT;
+    gdouble *s = (gdouble *) map.data;
+
+    n = map.size / sizeof (gdouble);
+    for (i = 0; i < n; i++) {
+      gdouble v = s[i];
+
+      if (v > limit)
+        s[i] = limit;
+      else if (v < -limit)
+        s[i] = -limit;
+      else if (G_UNLIKELY (v != v))
+        s[i] = 0.0;
+    }
   }
+
+  gst_buffer_unmap (outbuf, &map);
 }
 
