#!/bin/sh
# Launch X3 through the shared Wine lock, then preserve this session's evidence.
# Accepts the same options as tools/manage.py launch; see docs/verification/user-runs.md.
cd -- "$(dirname -- "$0")" || exit
x3run_since_ns=$(python3 -c 'import time; print(time.time_ns())') || exit
if X3M_BOTTLE=X3 python3 verification/probe/wine_lock.py --holder user-game \
    python3 tools/manage.py launch --bottle X3 "$@"; then
    x3run_status=0
else
    x3run_status=$?
fi
python3 tools/analysis/snapshot_x3_run.py --since-ns "$x3run_since_ns" || true
exit "$x3run_status"
