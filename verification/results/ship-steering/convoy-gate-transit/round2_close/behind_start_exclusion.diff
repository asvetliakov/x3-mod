+// Lane fix round 2 item C (cast behind_start: a capital committed 2 km behind the plane on Lambda, nose -F, while a Titan departs; as a
+// lane member its re-departure could not leave the departing corridor in time: member 0x12s, contact or P2 heading -F through its own
+// order point's sphere; section 11 item C): a ship whose commit is attempted while it is behind a lane gate's plane is no lane member
+// until it is in front of the plane by its own stop run-out (v^2 / 2a) + its half-length and outside the departing corridor (its lateral
+// from the gate's axis at least r_gate + its half-width + kMarginM). Until then the commit is refused: no lane order, no order-point
+// rewrite, no own-gate or obstacle suppression, no lane law; it flies the engine's own order 4 as a non-member (the members' rollouts and
+// site E treat it as any non-member ship). A committed member's refresh is never held (an overshoot keeps its membership); the hold
+// lapses kLaneBackKeepMs + the step after the last attempt. Key off: always true. O(kBackSlots) per commit attempt.
+constexpr std::uint32_t kLaneBackKeepMs = 60000;
+inline bool lane_entry_ok(Board& b, const Gate& g, std::uint32_t ship, const float x[3], float v, float a, float L, float w, std::uint32_t now) noexcept {
+    if (!g.lane || !ship) return true;
+    const int i = find(g, ship);
+    if (i >= 0 && g.m[i].role == Role::committed) return true;
+    std::uint32_t step = b.step_cur_ms > b.step_prev_ms ? b.step_cur_ms : b.step_prev_ms;
+    if (step > kStepClampMs) step = kStepClampMs;
+    int k = -1;
+    for (unsigned j = 0; j < Board::kBackSlots && k < 0; ++j)
+        if (b.bx_ship[j] == ship && b.bx_gate[j] == g.gate && b.bx_ms[j] && std::int32_t(now - b.bx_ms[j]) >= 0 &&
+            now - b.bx_ms[j] <= kLaneBackKeepMs + step)
+            k = int(j);
+    const float d[3] = {x[0] - g.G[0], x[1] - g.G[1], x[2] - g.G[2]};
+    const float s = sc::dot3(d, g.F);
+    if (!(s > 0.0f) && k < 0) return true;
+    if (!(s > 0.0f)) {
+        const float am = a > 0.1f ? a : 0.1f, vv = v > 0.0f ? v : 0.0f, run = vv * vv / (2.0f * am) + L;
+        const float e[3] = {d[0] - s * g.F[0], d[1] - s * g.F[1], d[2] - s * g.F[2]};
+        const float lat = sc::sqrt_ss(sc::dot3(e, e)), out = g.r_gate + w + kMarginM;
+        if (s <= -run && lat >= out) { // released: the commit proceeds
+            b.bx_ship[k] = b.bx_gate[k] = b.bx_ms[k] = 0;
+            return true;
+        }
+    }
+    if (k < 0) { // a free (or the oldest) slot
+        k = 0;
+        for (unsigned j = 1; j < Board::kBackSlots; ++j)
+            if (!b.bx_ms[k]) break;
+            else if (!b.bx_ms[j] || std::int32_t(b.bx_ms[j] - b.bx_ms[k]) < 0) k = int(j);
+    }
+    b.bx_ship[k] = ship;
+    b.bx_gate[k] = g.gate;
+    b.bx_ms[k] = now ? now : 1;
+    return false;
+}
