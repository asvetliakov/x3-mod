/build/
/build-ownership/
# x3m-regenerate bundles (tools/regenerate/build.py); its work tree is under /build/.
/dist/
/artifacts/
**/__pycache__/
*.pyc
verification/results/raw/
verification/probe/build/

# Generated shader dumps and transient game-launch diagnostics stay local.
verification/results/*.bin
verification/results/*-game-launch.log
verification/results/shortcut-launch.log
verification/results/game-turning-capture-summary.json

# Transient backend stderr/build diagnostics; scoped result manifests stay tracked.
verification/results/execution-ownership-wine.log
verification/results/geometry-lease-wine.log
verification/results/motion-capture-wine.log
verification/results/geometry-lease-build.txt

# Non-Steam bottle runs: raw capture logs (several MB each) stay local; the JSON/text records are tracked.
verification/results/bottle-*/*-capture.log
.claude/worktrees/

# Verbose per-image bloom reports remain local; compact reviewed records are tracked.
verification/results/bloom-filter-summary.json
verification/results/bottle-*/bloom-filter-summary.json

# Ownership fixture runs keep the check reports; the Wine stderr logs stay local.
verification/results/bottle-*/ownership-*-wine.log

# Chase-fire qualification keeps one compact summary; verbose case logs stay local.
verification/results/bottle-*/chase-fire-*.txt
verification/results/bottle-*/chase-fire-*-wine.log

# Combined bloom lifetime keeps a compact result; verbose runner logs stay local.
verification/results/bottle-*/capture-bloom-x3-ownership-*.txt
verification/results/bottle-*/capture-bloom-x3-ownership-*-wine.log
/screenshots/
# Ambient occlusion fixture: the Wine stderr log stays local; the JSON/text records are tracked.
verification/results/bottle-*/ambient-occlusion-gpu1-wine.log

# Port-distance fixture: the Wine stderr log stays local; the JSON/text records are tracked.
verification/results/bottle-*/port-distance*-wine.log
verification/results/bottle-*/effect-beginpass-wine.log
verification/results/bottle-*/motion-output-partial.txt
verification/results/bottle-*/motion-output-wine.log
verification/results/bottle-X3/material-motion.txt

# Per-candidate and per-run verbose fixture output (the compact figures are bound in
# verification/results/runNN-candidate-build.json; AGENTS.md: verbose logs stay local).
verification/results/bottle-*/state-hook-benchmark-run*.json
verification/results/bottle-*/state-hook-benchmark-run*-wine.log
verification/results/bottle-*/route-bench-run*.json
verification/results/bottle-*/route-bench-*-wine.log
verification/results/bottle-*/ownership-admission-*.txt
verification/results/bottle-*/ownership-admission-summary*.json
verification/results/ambient-occlusion-gpu1-wine.log
verification/results/ambient-occlusion-gpu1.json
verification/results/ambient-occlusion-gpu1.txt
verification/results/bottle-*/effect-technique-lookup-wine.log
verification/results/bottle-*/fog-pass-gpu1-wine.log

# Per-agent scratch builds (build-footprint, build-<topic>): local, never committed
/build-*/

# Atlas previews are downscaled game textures (copyrighted art): local, never committed
verification/results/lod-overlay-pilot/atlas_preview_*.png

# Voice decoder: the GStreamer registry cache (and its temp files) is rebuilt on first launch; never tracked.
tools/voice-decoder/v4/registry/

# GPU backend A/B fixture: summary.json and table.py are tracked; the raw fixture transcript stays local.
verification/results/bottle-*/gpu-backend-ab/fixture.txt
