/build/
/build-ownership/
/artifacts/
**/__pycache__/
*.pyc
verification/results/raw/
verification/probe/build/

# Generated shader dumps and transient game-launch diagnostics stay local.
verification/results/*.bin
verification/results/*-game-launch.log
verification/results/shortcut-launch.log
verification/results/game-turning-capture-summary.json

# Transient backend stderr/build diagnostics; scoped result manifests stay tracked.
verification/results/execution-ownership-wine.log
verification/results/geometry-lease-wine.log
verification/results/motion-capture-wine.log
verification/results/geometry-lease-build.txt

# Non-Steam bottle runs: raw capture logs (several MB each) stay local; the JSON/text records are tracked.
verification/results/bottle-*/*-capture.log
.claude/worktrees/

# Verbose per-image bloom reports remain local; compact reviewed records are tracked.
verification/results/bloom-filter-summary.json
verification/results/bottle-*/bloom-filter-summary.json

# Chase-fire qualification keeps one compact summary; verbose case logs stay local.
verification/results/bottle-*/chase-fire-*.txt
verification/results/bottle-*/chase-fire-*-wine.log

# Combined bloom lifetime keeps a compact result; verbose runner logs stay local.
verification/results/bottle-*/capture-bloom-x3-ownership-*.txt
verification/results/bottle-*/capture-bloom-x3-ownership-*-wine.log
/screenshots/